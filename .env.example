# 复制本文件为 .env，然后填入你的模型 API Key
# 支持任意 OpenAI 兼容接口（DashScope / OpenAI / vLLM 等）
LLM_BASE_URL=https://ws-42fyidjdi6plasl4.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-max
LLM_TIMEOUT_S=60

# 外部 RAG 运维平台（项目1提供，本项目只做 HTTP 调用）
RAG_BASE_URL=http://127.0.0.1:8001
RAG_QA_PATH=/api/v1/qa/search
RAG_API_KEY=

# 导航后端：auto / mock / ros
NAV_BACKEND=auto
